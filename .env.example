# SawaSwap Settlement Layer — environment template
# Copy to `.env` and fill in. `.env` is gitignored; do not commit secrets.

# ─── RPC + verification ──────────────────────────────────────────────────────
# Base Sepolia public RPC (chainId 84532). Replace with a private endpoint
# (Alchemy, Quicknode, etc.) if you prefer.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: Basescan API key for `forge verify-contract` source verification.
# Obtain from https://basescan.org/myapikey (or the Base Sepolia equivalent).
BASESCAN_API_KEY=

# ─── Canonical deploy (script/Deploy.s.sol) ──────────────────────────────────
# Admin address MUST equal the canonical address pinned 2026-05-26. The deploy
# script enforces equality and reverts otherwise. To change this address, both
# Parties must agree in writing and the constant in `Deploy.s.sol` must be
# updated in a tracked commit.
ADMIN_ADDRESS=0x434F2A01CccAEcFAa884b42e7c72e46D69ecB76e

# Circle-issued testnet USDC on Base Sepolia.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Initial default time windows (seconds). Locked per transaction at PoI commit
# (§C.3.3); subsequent admin changes do not retroactively affect committed
# transactions. The values below are M1-RUNBOOK demo defaults — short windows
# for fast hands-on iteration on testnet. Adjust to whatever your verification
# flow needs.
DEFAULT_TW1_SECONDS=600
DEFAULT_TW2_SECONDS=1800
DEFAULT_TW3_SECONDS=3600

# ─── Dev deploy (script/DeployDev.s.sol) — Developer side only ───────────────
# Both vars below are optional for the dev script. If unset, DeployDev deploys
# a fresh MockERC20 inline (lets verification flows mint freely without a
# faucet) and uses `tx.origin` (the broadcaster EOA) as admin.
#
# DEV_WALLET_ADDRESS=<filled by `cast wallet new` on provisioning>
# DEV_WALLET_PRIVATE_KEY=<filled by `cast wallet new` on provisioning>
